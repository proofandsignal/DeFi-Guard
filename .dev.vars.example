# Local/development placeholders only.
# Copy to .dev.vars and fill values locally. Never commit real secrets.

# Existing generic provider mode (default):
# SNAPSHOT_PROVIDER_KIND=generic-post
# SNAPSHOT_PROVIDER_URL=https://example.com/internal/defi-position-snapshot

# BUILD-004 reuse path:
SNAPSHOT_PROVIDER_KIND=defi-risk-monitor
SNAPSHOT_PROVIDER_URL=https://example.com
SNAPSHOT_PROVIDER_TOKEN=replace-me

RESEND_API_KEY=re_replace_me
ALERT_EMAIL_FROM=DeFi Guard <alerts@example.com>

# Optional. Applied to all generic webhook deliveries.
WEBHOOK_BEARER_TOKEN=replace-me

DELIVERY_RETRY_MAX_ATTEMPTS=3
DELIVERY_RETRY_BATCH_SIZE=50
